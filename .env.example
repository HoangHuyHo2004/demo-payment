# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev only: password for the seeded accounts (admin@petrol.test, staff1@petrol.test, staff2@petrol.test)
SEED_PASSWORD=choose-a-dev-password

# Dev only: lets the worker (npm run worker) read the mock portal. The web app
# itself never talks to the vendor portal; see worker/.env.example.
VENDOR_MODE=mock
