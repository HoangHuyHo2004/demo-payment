# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev only: password for the seeded accounts (admin@petrol.test, staff1@petrol.test, staff2@petrol.test)
SEED_PASSWORD=choose-a-dev-password

# Vendor adapter: "mock" until the real vendor API docs arrive (Phase 3)
VENDOR_MODE=mock
# Base URL the server uses to reach the vendor API (mock: this app itself).
# Defaults to https://$VERCEL_URL on Vercel, http://localhost:3000 locally.
# VENDOR_BASE_URL=http://localhost:3000

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/sync
CRON_SECRET=generate-a-long-random-string
