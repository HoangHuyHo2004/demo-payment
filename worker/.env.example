# Copy to worker/.env on the machine that runs the worker. Never commit .env.
# For local development the worker also reads ../.env.local, so nothing is
# needed here in mock mode.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# mock          -> the built-in mock portal (development and tests)
# portal_http   -> real portal, JSON endpoint with the login session (Phase 3b)
# portal_scrape -> real portal, read the transaction table from the page (Phase 3b)
VENDOR_MODE=mock

# Real portal only. One dedicated READ-ONLY login per station, from the owner.
# PORTAL_URL=https://portal.example.vn
# PORTAL_ACCOUNTS=[{"station_id":"<stations.id>","username":"...","password":"..."}]

# Mock mode only: port of the built-in mock portal (default 4010). Set PORTAL_URL
# to use a mock portal that is already running elsewhere instead.
# MOCK_PORTAL_PORT=4010
